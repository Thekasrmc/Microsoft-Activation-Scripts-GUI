                                    <Border Background="#232332" BorderBrush="#2D2B3D" BorderThickness="1" CornerRadius="8" Margin="3" Padding="7"><ui:ToggleSwitch x:Name="ToggleExcel" Tag="Excel" Content="Excel" IsChecked="True"/></Border>
                                    <Border Background="#232332" BorderBrush="#2D2B3D" BorderThickness="1" CornerRadius="8" Margin="3" Padding="7"><ui:ToggleSwitch x:Name="ToggleOneNote" Tag="OneNote" Content="OneNote" IsChecked="True"/></Border>
                                    <Border Background="#232332" BorderBrush="#2D2B3D" BorderThickness="1" CornerRadius="8" Margin="3" Padding="7"><ui:ToggleSwitch x:Name="ToggleOutlookClassic" Tag="Outlook (Classic)" Content="Outlook (Classic)" IsChecked="True"/></Border>
                                    <Border Background="#232332" BorderBrush="#2D2B3D" BorderThickness="1" CornerRadius="8" Margin="3" Padding="7"><ui:ToggleSwitch x:Name="TogglePowerPoint" Tag="PowerPoint" Content="PowerPoint" IsChecked="True"/></Border>
