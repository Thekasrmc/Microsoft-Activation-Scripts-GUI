<ui:FluentWindow x:Class="MySystemGui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Microsoft-Activation-Scripts GUI"
                 Icon="/MySystemGui;component/logo.png"
                 Width="1100"
                 Height="680"
                 MinWidth="900"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 Background="#101014"
                 Foreground="#F3F4F6"
                 FontFamily="pack://application:,,,/MySystemGui;component/Fonts/#Inter"
                 ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <Style TargetType="{x:Type ui:TitleBarButton}"
               BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
            <Setter Property="Height" Value="56"/>
        </Style>
        <SolidColorBrush x:Key="AccentBrush" Color="#C65AE8"/>
        <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#E044B8"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F2FA"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A5A0AD"/>
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1"
                             ColorInterpolationMode="ScRgbLinearInterpolation">
            <GradientStop Color="#EF292633" Offset="0"/>
            <GradientStop Color="#E5222029" Offset="0.14"/>
            <GradientStop Color="#E51B1A22" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3BC65AE8" Offset="0"/>
            <GradientStop Color="#29E044B8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ActionButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D65F259F" Offset="0"/>
            <GradientStop Color="#DDE044B8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ActionButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F07D3BC0" Offset="0"/>
            <GradientStop Color="#F0F05BC8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitleBarBackgroundBrush"
                             StartPoint="0,0.5"
                             EndPoint="1,0.5"
                             ColorInterpolationMode="ScRgbLinearInterpolation">
            <GradientStop Color="#22041E" Offset="0"/>
            <GradientStop Color="#1D1324" Offset="0.25"/>
            <GradientStop Color="#292535" Offset="0.5"/>
            <GradientStop Color="#332634" Offset="0.8"/>
            <GradientStop Color="#372D32" Offset="0.9"/>
            <GradientStop Color="#1B1B1D" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TitleBarLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkBorder" Property="Background" Value="#2CC65AE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C65AE8" BlurRadius="18" ShadowDepth="2" Opacity="0.11"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F32B2435"/>
                    <Setter Property="BorderBrush" Value="#90DA49B9"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#C65AE8" BlurRadius="22" ShadowDepth="2" Opacity="0.32"/>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-2"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0"
                                                 Duration="0:0:0.24">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModuleGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#D817151D"/>
            <Setter Property="BorderBrush" Value="#32BE78DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="ModuleTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ModuleDescriptionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ModuleIconStyle" TargetType="Path">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C65AE8" BlurRadius="7" ShadowDepth="0" Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource ActionButtonBrush}"/>
            <Setter Property="Foreground" Value="#160D1B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#C65AE8" BlurRadius="8"
                                                  ShadowDepth="0" Opacity="0.14"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource ActionButtonHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E044B8" BlurRadius="15"
                                                          ShadowDepth="0" Opacity="0.34"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D8D1E2"/>
            <Setter Property="Background" Value="#8C211D29"/>
            <Setter Property="BorderBrush" Value="#3DBE78DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="#C32F2440"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="#99C65AE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="#232332"/>
            <Setter Property="Foreground" Value="#F5F2FA"/>
            <Setter Property="BorderBrush" Value="#2D2B3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#30283A"/>
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#D946EF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalHeaderButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#232332"/>
            <Setter Property="Foreground" Value="#F5F2FA"/>
            <Setter Property="BorderBrush" Value="#2D2B3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderButtonBorder" Property="Background" Value="#30283A"/>
                                <Setter TargetName="HeaderButtonBorder" Property="BorderBrush" Value="#D946EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GuideButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#2D2038"/>
            <Setter Property="Foreground" Value="#F8EAFE"/>
            <Setter Property="BorderBrush" Value="#A855F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GuideButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#D946EF"
                                                  BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.32"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="#3DD946EF"
                                        BorderBrush="#75D946EF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="7,3"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="READ FIRST"
                                               Foreground="#FCE7FF"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GuideButtonBorder" Property="Background" Value="#3A2647"/>
                                <Setter TargetName="GuideButtonBorder" Property="BorderBrush" Value="#E879F9"/>
                                <Setter TargetName="GuideButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E879F9"
                                                          BlurRadius="24"
                                                          ShadowDepth="0"
                                                          Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GuideButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9A6E5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,6,0,5"/>
        </Style>

        <Style x:Key="ModalTextBoxStyle" TargetType="ui:TextBox">
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="Foreground" Value="#F5F2FA"/>
            <Setter Property="BorderBrush" Value="#2D2B3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop x:Name="GlowCenterStop" Color="#FF3B1B62" Offset="0"/>
                <GradientStop x:Name="GlowMiddleStop" Color="#FF2A1643" Offset="0.32"/>
                <GradientStop x:Name="GlowOuterStop" Color="#FF17121D" Offset="0.68"/>
                <GradientStop Color="#FF101014" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever"
                                Timeline.DesiredFrameRate="10">
                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="GlowCenterStop"
                                                      Storyboard.TargetProperty="Color"
                                                      Duration="0:1:30">
                            <LinearColorKeyFrame Value="#FF3B1B62" KeyTime="0:0:0"/>
                            <LinearColorKeyFrame Value="#FF602764" KeyTime="0:0:30"/>
                            <LinearColorKeyFrame Value="#FF8B3077" KeyTime="0:1:0"/>
                            <LinearColorKeyFrame Value="#FF3B1B62" KeyTime="0:1:30"/>
                        </ColorAnimationUsingKeyFrames>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="GlowMiddleStop"
                                                      Storyboard.TargetProperty="Color"
                                                      Duration="0:1:30">
                            <LinearColorKeyFrame Value="#FF2A1643" KeyTime="0:0:0"/>
                            <LinearColorKeyFrame Value="#FF421E43" KeyTime="0:0:30"/>
                            <LinearColorKeyFrame Value="#FF5D2550" KeyTime="0:1:0"/>
                            <LinearColorKeyFrame Value="#FF2A1643" KeyTime="0:1:30"/>
                        </ColorAnimationUsingKeyFrames>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="GlowOuterStop"
                                                      Storyboard.TargetProperty="Color"
                                                      Duration="0:1:30">
                            <LinearColorKeyFrame Value="#FF17121D" KeyTime="0:0:0"/>
                            <LinearColorKeyFrame Value="#FF1D141D" KeyTime="0:0:30"/>
                            <LinearColorKeyFrame Value="#FF27151F" KeyTime="0:1:0"/>
                            <LinearColorKeyFrame Value="#FF17121D" KeyTime="0:1:30"/>
                        </ColorAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                IsHitTestVisible="False"
                Opacity="0.018">
            <Border.Background>
                <ImageBrush ImageSource="/MySystemGui;component/ambient-noise.png"
                            TileMode="Tile"
                            Viewport="0,0,512,512"
                            ViewportUnits="Absolute"
                            Stretch="None"/>
            </Border.Background>
        </Border>

        <ui:TitleBar Grid.Row="0"
                     Height="56"
                     Title="MAS"
                     Background="{StaticResource TitleBarBackgroundBrush}"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Center"
                     ButtonsForeground="{StaticResource PrimaryTextBrush}"
                     ButtonsBackground="#4DC65AE8"
                     CanMaximize="True"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/MySystemGui;component/logo.png"
                           Width="32"
                           Height="32"
                           Stretch="Uniform"
                           Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="MAS"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Border Background="#211B1B26"
                            BorderBrush="#2D2B3D"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="7,3"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            ToolTip="Application version">
                        <TextBlock x:Name="TxtAppVersion"
                                   Text="v3.14 So Sorry!"
                                   Foreground="#A5A0AD"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="by thekasrmc"
                               Foreground="#A5A0AD"
                               FontSize="10"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"/>
                    <Button Content="Blog"
                            Style="{StaticResource TitleBarLinkStyle}"
                            Margin="0,0,18,0"
                            Click="BtnBlog_Click"/>
                    <Button Content="Contact Us"
                            Style="{StaticResource TitleBarLinkStyle}"
                            Margin="0,0,16,0"
                            Click="BtnContactUs_Click"/>
                    <Button Style="{StaticResource TitleBarLinkStyle}"
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Click="BtnGithub_Click"
                            ToolTip="Open MAS website">
                        <Image Source="/MySystemGui;component/gitlogo.png"
                               Width="21"
                               Height="21"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Border Grid.Row="0"
                Height="3"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Opacity="0.9">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"
                                     SpreadMethod="Repeat"
                                     ColorInterpolationMode="ScRgbLinearInterpolation">
                    <GradientStop Color="#FF5F259F" Offset="0"/>
                    <GradientStop Color="#FF10D7D1" Offset="0.16"/>
                    <GradientStop Color="#FFDA49B9" Offset="0.34"/>
                    <GradientStop Color="#FF10D7D1" Offset="0.5"/>
                    <GradientStop Color="#FFFF6045" Offset="0.68"/>
                    <GradientStop Color="#FF5F259F" Offset="0.84"/>
                    <GradientStop Color="#FF5F259F" Offset="1"/>
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform x:Name="DividerGradientTransform" X="0"/>
                    </LinearGradientBrush.RelativeTransform>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever"
                                    Timeline.DesiredFrameRate="10">
                            <DoubleAnimation Storyboard.TargetName="DividerGradientTransform"
                                             Storyboard.TargetProperty="X"
                                             From="0" To="1"
                                             Duration="0:0:10"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Border.Effect>
                <DropShadowEffect Color="#FF5F259F"
                                  BlurRadius="6"
                                  ShadowDepth="0"
                                  Opacity="0.3"/>
            </Border.Effect>
        </Border>

        <Grid Grid.Row="1" Margin="32,12,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MaxWidth="1000"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ModuleGroupStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Activated Modules"
                                   Foreground="#D28AF0"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="4,2,4,10"/>
                        <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                <Border Style="{StaticResource ModuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Path Grid.Row="0" Style="{StaticResource ModuleIconStyle}"
