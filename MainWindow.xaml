                                            Style="{StaticResource ModalActionButtonStyle}" Margin="3" Click="OfficeChannel_Click"/>
                                    <Button Content="Perpetual2021 VL" Tag="Perpetual2021 VL"
                                            Style="{StaticResource ModalActionButtonStyle}" Margin="3" Click="OfficeChannel_Click"/>
                                    <Button Content="Perpetual2024 VL" Tag="Perpetual2024 VL"
                                            Style="{StaticResource ModalActionButtonStyle}" Margin="3" Click="OfficeChannel_Click"/>
