                                    <Button Content="[2] Download Genuine Windows / Office"
                                            Tag="[2] Download Genuine Windows / Office"
                                            Style="{StaticResource ModalActionButtonStyle}"
                                            MinHeight="180"
                                            Margin="5"
                                            Click="DownloadMedia_Click"/>
                                </UniformGrid>
                            </Grid>
                            <Grid x:Name="ExtrasStep2" Visibility="Collapsed">
