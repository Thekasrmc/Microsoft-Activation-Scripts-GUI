                                </UniformGrid>
                                <Button Grid.Row="2"
                                        Content="Continue &amp; Apply"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardActionButtonStyle}"
                                        Padding="18,8"
                                        Margin="3,8,3,0"
